{
  "name": "clipshelf",
  "version": "0.1.0",
  "description": "A private, local-first clipboard shelf for Linux and Windows.",
  "main": "src/main.js",
  "author": "catsu-byte",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:windows": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.catsubyte.clipshelf",
    "productName": "ClipShelf",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "ClipShelf-${version}-Linux-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "ClipShelf-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
